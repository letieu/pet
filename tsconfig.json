{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "sitepet": ["./packages/sitepet/src/index.ts"],
      "sitepet/react": ["./packages/sitepet/src/react/index.tsx"],
      "sitepet/*": ["./packages/sitepet/src/*"]
    }
  },
  "include": ["src", "packages/sitepet/src"]
}
